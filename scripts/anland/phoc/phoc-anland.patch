-  if (G_UNLIKELY (priv->gamma_lut_changed))
-    phoc_output_set_gamma_lut (self, &pending);
+#ifdef HAVE_ANLAND
+  anland = mango_anland_output_is (wlr_output);
+#endif
+
+  if (G_UNLIKELY (priv->gamma_lut_changed)) {
+    /* Anland cannot apply gamma tables. Drop the request rather than
