diff --git a/src/meson.build b/src/meson.build
index 928c451..8ead85f 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -203,6 +203,41 @@ if have_xwayland
   phoc_deps += dependency('xcb')
 endif
 
+if get_option('anland').enabled()
+  # The backend comes unmodified from Anland's Mango producer. It is built on
+  # its own so phoc's stricter warning set does not apply to foreign code.
+  display_producer_dep = dependency('display-producer')
+  phoc_anland_backend = static_library(
+    'phoc-anland-backend',
+    files(
+      'anland_backend/anland.c',
+      'anland_backend/buffer.c',
+      'anland_backend/clipboard.c',
+      'anland_backend/input.c',
+      'anland_backend/output.c',
+      'anland_backend/text.c',
+    ),
+    include_directories: include_directories('anland/compat', 'anland_backend'),
+    c_args: cc.get_supported_arguments(
+      '-DHAVE_ANLAND',
+      '-fno-analyzer',
+      '-Wno-error',
+      '-Wno-missing-declarations',
+      '-Wno-shadow',
+      '-Wno-switch-default',
+      '-Wno-undef',
+    ),
+    dependencies: [display_producer_dep, drm, wayland_server, wlroots, xkbcommon],
+  )
+  sources += files('anland/phoc-anland.c', 'anland/phoc-anland.h')
+  phoc_deps += declare_dependency(
+    compile_args: '-DHAVE_ANLAND',
+    include_directories: include_directories('anland', 'anland/compat'),
+    link_with: phoc_anland_backend,
+    dependencies: display_producer_dep,
+  )
+endif
+
 phoc_lib = both_libraries(
   'phoc',
   sources,
